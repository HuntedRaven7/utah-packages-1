# Hummingbird's rawhide variant is pinned to Fedora 44 (images/variables.yml,
# default_variant_repos.rawhide -> fedora-44.repo), so Fedora 44 -- not the
# rolling Rawhide -- is the release its packages are built against. Rawhide is
# three releases ahead and has moved to OpenSSL 4, which Hummingbird pins
# against; building there produces RPMs a Hummingbird system cannot install.
[fedora-44]
name=Fedora 44 - $basearch
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/$basearch/os/
enabled=1
metadata_expire=6h
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=https://fedoraproject.org/fedora.gpg
skip_if_unavailable=False

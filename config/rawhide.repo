[fedora-rawhide]
name=Fedora Rawhide - Everything - $basearch
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/development/rawhide/Everything/$basearch/os/
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://fedoraproject.org/fedora.gpg

[fedora-rawhide-source]
name=Fedora Rawhide - Sources
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/development/rawhide/Everything/source/tree/
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://fedoraproject.org/fedora.gpg

 	uint8_t*	buf = alloca (sectors * geom->dev->sector_size);
 
 	if (!ped_geometry_read (geom, buf, 16 * 512 / geom->dev->sector_size, sectors))
-		return 0;
+		return NULL;
 
 	sb = (struct ufs_super_block *)buf;
 

summary: Install Fedora specific GNOME desktop components
description:
    The listed packages are available in Fedora only.
enabled: false
adjust:
    when: distro == fedora
    enabled: true
require:
    - gnome-screenshot
    - yelp
    - adobe-source-code-pro-fonts
    - decibels
    - glycin-thumbnailer
    - gnome-backgrounds
    - gnome-calendar
    - gnome-contacts
    - gnome-epub-thumbnailer
    - gnome-logs
    - gnome-maps
    - gnome-photos
    - gnome-user-share
    - gnome-weather
    - gst-thumbnailers
    - gvfs-afc
    - gvfs-fuse
    - gvfs-gphoto2
    - gvfs-smb
    - loupe
    - NetworkManager-openconnect-gnome
    - NetworkManager-openvpn-gnome
    - NetworkManager-pptp-gnome
    - NetworkManager-ssh-gnome
    - NetworkManager-vpnc-gnome
    - papers
    - papers-nautilus
    - rygel
    - simple-scan
    - showtime
    - snapshot
    - sushi
    - vte-profile

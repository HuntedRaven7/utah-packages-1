@@ -639,7 +639,7 @@ create_resize_context (PedFileSystem* fs, const PedGeometry* new_geom)
 						* sizeof (FatDirEntry) / 512;
 
 	if (!get_fat_type (fs, new_geom, &new_fat_type))
-		return 0;
